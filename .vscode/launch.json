{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F103",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/stm32-smart-irrigation.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f1x.cfg"
      ],
      "runToEntryPoint": "main",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    }
  ]
}