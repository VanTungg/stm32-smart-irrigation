
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32F103C8T6 - Debug OpenOCD",
            "type": "cortex-debug",
            "request": "launch",

            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/stm32-smart-irrigation.elf",

            "servertype": "openocd",
            "serverpath": "D:/openocd-20260302/OpenOCD-20260302-0.12.0/bin/openocd.exe",
            "searchDir": [
                "D:/openocd-20260302/OpenOCD-20260302-0.12.0/share/openocd/scripts"
            ],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f1x.cfg"
            ],

            "gdbPath": "D:/armtoolchain/bin/arm-none-eabi-gdb.exe",

            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        }
    ]
}
